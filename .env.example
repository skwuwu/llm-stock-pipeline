# 복사해서 .env 로 쓸 것. .env 는 .gitignore 대상이다.

# DART OpenAPI — 40자리 16진수. 잘려 있으면 "등록되지 않은 인증키"라는
# 원인 불명 에러만 나므로 클라이언트가 형식을 검증한다.
DART_API_KEY=여기에_DART_발급키

ANTHROPIC_API_KEY=sk-ant-...

# ── 선택: 한국투자증권 KIS Open API (두 번째 가격 소스) ──
# 없어도 파이프라인은 돈다. 다만 가격 소스가 FDR 하나뿐이면
# **주가 오류를 잡을 수 없다** — 시총·PER·PBR 이 전부 같은 종가에서 나오므로
# 종가가 틀리면 셋이 함께 틀리고 서로를 검증하지 못한다.
#
# 발급: 한국투자증권 KIS Developers (실계좌 또는 모의계좌 필요)
# 넣은 뒤 반드시 프로브부터:
#     pipeline probe-price --source kis --as-of <date>
# 프로브를 통과하기 전에는 대량 수집이 거부된다.
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ENV=real          # real | vps(모의투자)
